# Local configuration and secrets. Commit this template; keep the filled .env ignored.
# ctl setup copies this file and generates blank local secrets. Process environment wins.
# Only explicitly selected public constants may reach browser code.

#################### DEBUGGING ##########################
#################################################################
# Add project-specific debugging keys here; select browser flags explicitly in framework config.

#################### SERVICE ADDRESSES ##########################
#################################################################

# Public origin
# Host-side bindings and routes; Docker declares internal names and ports per service.
# what the browser sees. prod: https://<domain>
PUBLIC_URL=http://localhost
# published by ctl up +expose_web
HTTP_PORT=80
HTTPS_PORT=443

# Development proxy
# docker/compose.dev.yaml — the one origin under ctl dev --proxy
DEV_PROXY_PORT=3080

# API
# docker: api
API_HOST=localhost
API_PORT=8000
API_PREFIX=/api

# Web app
# Vite SPA. Also the port of apps/web
WEB_APP_PORT=5173

# Postgres
# docker: compose sets `postgres`
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
# docker: `redis`
REDIS_HOST=localhost
REDIS_PORT=6379

# Payments
# optional backend integration
# PAYMENTS_URL=https://api.stripe.com

#################### DATA PATHS ##########################
#################################################################

# Storage
# ctl and bind mounts use root-relative paths, or absolute paths on a deployment host.
# actual data: engine mounts (${DATA_DIR}/postgres …), datasets, uploads
DATA_DIR=./data

# Logs and backups
# produced state: logs/dev, logs/run, logs/backups, logs/test_build
LOGS_DIR=./logs
# ctl db backup writes <BACKUP_DIR>/<timestamp>/
BACKUP_DIR=${LOGS_DIR}/backups

# Datasets
# enable only for a training app
# DATASET_DIR=${DATA_DIR}/datasets

#################### SECRETS ##########################
#################################################################

# Postgres
# Backend and database values; credential-bearing URLs remain server-only.
# ctl setup generates blank _PASSWORD, _KEY and _SECRET keys. Rotate passwords yearly or on leak.
POSTGRES_USER=app
# generated by ctl setup: openssl rand -base64 24 | tr -d '+/=' | head -c 24
POSTGRES_PASSWORD=
POSTGRES_DB=app
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis
# generated by ctl setup
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

# Shared authentication
# generated by ctl setup: openssl rand -hex 32. Rotate on leak; invalidates every token.
JWT_SIGNING_KEY=

# API encryption
# generated by ctl setup: openssl rand -hex 32. Never rotate without a re-encrypt migration.
ENCRYPTION_KEY_PYTHON=

# Google authentication
# Provider credentials: obtain from the provider, then uncomment and fill; never auto-generate.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# OpenAI
# backend proxy only; rotate on leak
# OPENAI_API_KEY=

#################### DEPLOYMENT ##########################
#################################################################

# Compose
# Compose project identity and image selection.
COMPOSE_PROJECT_NAME=<project>

# Images
REGISTRY=ghcr.io/<org>
# immutable per deploy: a git sha or a semver. `dev` is for local builds only
TAG=dev
