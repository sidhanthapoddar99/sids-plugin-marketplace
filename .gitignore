# Raw skill test runs. The eval prompts live in evals/<plugin>/evals.json at the repo root;
# the transcripts and outputs from running them are kept here and never committed.
plugins/*/evals-workspace/

# Local working files, never committed: the session TODO names private projects,
# and .worktrees/ holds local git worktrees.
/TODO.md
/.worktrees/

# Python bytecode caches that pytest writes beside the skill tests. They are machine-local,
# so a commit only adds noise, and an install would copy them into every plugin cache.
__pycache__/
*.pyc
