# Curated for the ecosystems present. Runtime state is handled by data/.gitignore.

# env files and local overrides. Only the *.template files are committed.
.env
.env.*
!.env.*.template
config.local.yaml

# python
__pycache__/
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
coverage/
.coverage

# rust
target/

# go
apps/example-tui-go/bin/

# js
node_modules/
dist/
.next/
*.tsbuildinfo

# tooling — commit project config, ignore personal
.vscode/*
!.vscode/launch.json
!.vscode/settings.json
.claude/settings.local.json

# gate runtime
scripts/gate/gate.lock
.jscpd/

# logs and OS
*.log
.DS_Store
