# .env.data — where data lives on this machine.
#
# Purpose   Every path the stack writes to or reads from: engine mounts, datasets, logs, backups.
# Readers   docker compose (bind mounts in compose.db.yaml), ctl (setup, backup, frozen builds),
#           and any app that touches disk directly (ML training, uploads).
# Template  `ctl setup` copies this file to .env.data. Defaults point inside the repo.
# Rules     Every path is relative to the repo root. ctl runs compose with --project-directory <root>,
#           so ./data here means <root>/data everywhere. Never ../
#           On a server, point DATA_DIR at the real disk (/srv/<project>/data). Nothing else changes.

DATA_DIR=./data                        # actual data: engine mounts (${DATA_DIR}/postgres …), datasets, uploads
LOGS_DIR=./logs                        # produced state: logs/dev, logs/run, logs/backups, logs/test_build
BACKUP_DIR=${LOGS_DIR}/backups         # ctl db backup writes <BACKUP_DIR>/<timestamp>/
# DATASET_DIR=${DATA_DIR}/datasets     # ML: uncomment when a training app exists
