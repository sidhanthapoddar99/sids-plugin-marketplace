# The production edge, rendered by the nginx image's envsubst at start (/etc/nginx/templates → conf.d).
# One origin, path-routed. Static frontends are baked into this image; the rest is proxied.
#
# Two kinds of variable, both set in docker/compose.base.yaml `environment:` on the `web` service:
#   prefixes   ${WEB_APP_PREFIX} ${WEB_DOCS_PREFIX} ${DASHBOARD_PREFIX} ${API_PREFIX} ${ENGINE_PREFIX}
#              → ${VAR} from the root .env. The operator decides them.
#   upstreams  ${API_UPSTREAM} ${ENGINE_UPSTREAM} ${DASHBOARD_UPSTREAM}
#              → literals in compose.base.yaml (api:8000, engine:8080, dashboard:3000) because compose
#                decides the service names. `ctl up +env_override` swaps them for ${API_HOST}:${API_PORT}
#                etc. from .env when a backend runs outside this compose.
# NGINX_ENVSUBST_FILTER (set in compose) limits substitution to these names, so nginx's own
# $host / $uri / $request_uri survive.
# Listens on 8080: the image runs as the unprivileged nginx user. TLS terminates at traefik or the host.

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;
    client_max_body_size 20m;

    # ---- static: landing at / ----
    location = / { try_files /index.html =404; }
    location / { try_files $uri $uri/ $uri/index.html =404; }

    # ---- static: SPA with history fallback ----
    location ${WEB_APP_PREFIX}/ {
        try_files $uri $uri/ ${WEB_APP_PREFIX}/index.html;
    }

    # ---- static: docs ----
    location ${WEB_DOCS_PREFIX}/ {
        try_files $uri $uri/ $uri/index.html =404;
    }

    # ---- proxied: dashboard (Next.js server) ----
    location ${DASHBOARD_PREFIX}/ {
        proxy_pass http://${DASHBOARD_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ---- proxied: api (websocket-capable) ----
    location ${API_PREFIX}/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # ---- proxied: engine (websocket-capable) ----
    location ${ENGINE_PREFIX}/ {
        proxy_pass http://${ENGINE_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
