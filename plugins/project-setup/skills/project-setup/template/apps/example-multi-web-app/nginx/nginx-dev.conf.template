# The dev proxy: same origin in development with several frontends. Used by docker/compose.dev.yaml,
# which runs nginx with network_mode: host, so every upstream is a dev server on 127.0.0.1.
# Same locations as prod.conf.template; every one is proxied (nothing is static in dev) and every one
# carries the websocket upgrade so Vite / Next HMR works through the proxy.
# All ${VAR} come from .env.proxy via compose.dev.yaml `environment:`.

map $http_upgrade $connection_upgrade { default upgrade; '' close; }

server {
    listen ${DEV_PROXY_PORT};
    server_name _;
    client_max_body_size 20m;

    location ${WEB_APP_PREFIX}/     { proxy_pass http://127.0.0.1:${WEB_APP_PORT};     include /etc/nginx/nginx-dev-headers.conf; }
    location ${WEB_DOCS_PREFIX}/    { proxy_pass http://127.0.0.1:${WEB_DOCS_PORT};    include /etc/nginx/nginx-dev-headers.conf; }
    location ${DASHBOARD_PREFIX}/   { proxy_pass http://127.0.0.1:${DASHBOARD_PORT};   include /etc/nginx/nginx-dev-headers.conf; }
    location ${API_PREFIX}/         { proxy_pass http://127.0.0.1:${API_PORT};         include /etc/nginx/nginx-dev-headers.conf; }
    location ${ENGINE_PREFIX}/      { proxy_pass http://127.0.0.1:${ENGINE_PORT};      include /etc/nginx/nginx-dev-headers.conf; }
    location /                      { proxy_pass http://127.0.0.1:${WEB_LANDING_PORT}; include /etc/nginx/nginx-dev-headers.conf; }
}
