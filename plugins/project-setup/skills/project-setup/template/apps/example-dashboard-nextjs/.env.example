# Frontend env. Read only in dev mode (`bun dev`). Gitignored as .env.
# In prod the image is built by `ctl build` (this file forwarded as build args), and the server
# side gets API_HOST / API_PORT from compose.base.yaml `environment:`. Never from this file.
# NEXT_PUBLIC_* keys are public. Server-only keys (no prefix) are allowed only because this app
# runs a server; they still come from the root .env under `ctl dev`, never from here.
NEXT_PUBLIC_APP_NAME=<display name>
