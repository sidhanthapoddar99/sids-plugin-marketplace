{
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "max-depth": [
      "error",
      4
    ],
    "max-lines-per-function": [
      "error",
      {
        "max": 80,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-params": [
      "error",
      5
    ]
  }
}
