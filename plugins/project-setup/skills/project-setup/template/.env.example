# The env contract. Every key the stack reads. Secrets blank. Non-secrets carry the dev value.
# `ctl setup` copies this to .env and fills empty *_KEY and *_PASSWORD values.
# Host values are for `ctl dev` (apps on host). compose.base.yaml overrides them with service names.

# --- postgres (consumer: api, engine, migrations) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost          # prod: postgres
POSTGRES_PORT=5432
POSTGRES_DB=app
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- redis (consumer: api) ---
REDIS_PASSWORD=
REDIS_HOST=localhost             # prod: redis
REDIS_PORT=6379
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

# --- neo4j (consumer: engine) ---
NEO4J_PASSWORD=
NEO4J_HOST=localhost             # prod: neo4j
NEO4J_BOLT_PORT=7687
NEO4J_URL=bolt://${NEO4J_HOST}:${NEO4J_BOLT_PORT}

# --- services (consumer: nginx, web proxy, cli) ---
API_HOST=localhost               # prod: api
API_PORT=8000
ENGINE_HOST=localhost            # prod: engine
ENGINE_PORT=8080
SITE_PORT=3000
WEB_PORT=5173
API_PREFIX=/api
ENGINE_PREFIX=/engine

# --- shared secrets (consumer: api, engine) ---
JWT_SIGNING_KEY=
ENCRYPTION_KEY_PYTHON=
ENCRYPTION_KEY_RUST=

# --- public ---
PUBLIC_URL=http://localhost
PUBLIC_HOST=localhost            # traefik Host() rule

# --- frontend build args (consumer: compose.base.yaml build.args) ---
# Mirror of apps/web/.env.example and apps/site/.env.example. Public values only.
VITE_APP_NAME=<project>
NEXT_PUBLIC_SITE_NAME=<project>

# --- compose plumbing ---
COMPOSE_PROJECT_NAME=<project>
DATA_DIR=./data
REGISTRY=ghcr.io/<org>
TAG=latest
HTTP_PORT=80
HTTPS_PORT=443
