# The env contract. Every key the stack reads. Secrets blank. Non-secrets carry the dev value.
# `ctl setup` copies this to .env and fills every blank *_KEY and *_PASSWORD.
#
# Rules
# 1. Every secret of the project lives here, in one place. Only backend services read it.
#    A client-facing app never does. One exception: a Next.js server that proxies or runs its own routes.
# 2. docker compose and ctl read only this file. Never an app's .env or config.yaml.
# 3. ctl and compose always run from the repo root (`--project-directory`). Every path in this file
#    is relative to the root. Never `../`.
# 4. A value lives in exactly one file, chosen by who reads it:
#      compose, ctl, a backend   -> this file
#      a frontend in dev mode    -> apps/<frontend>/.env  (VITE_* / NEXT_PUBLIC_*, public)
#      a backend literal default -> apps/<backend>/config.yaml; developer override -> config.local.yaml
# 5. Host values below (localhost, ports) are for `ctl dev`, apps on the host.
#    Under docker, compose.base.yaml sets the service names itself; this file supplies only secrets and ports.
# 6. Backend precedence: process env > config.local.yaml > config.yaml. The loader reads this file
#    skip-if-set, so a real environment variable always wins.

# --- postgres (consumer: api, engine, migrations) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost          # prod: postgres
POSTGRES_PORT=5432
POSTGRES_DB=app
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- redis (consumer: api) ---
REDIS_PASSWORD=
REDIS_HOST=localhost             # prod: redis
REDIS_PORT=6379
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

# --- neo4j (consumer: engine) ---
NEO4J_PASSWORD=
NEO4J_HOST=localhost             # prod: neo4j
NEO4J_BOLT_PORT=7687
NEO4J_URL=bolt://${NEO4J_HOST}:${NEO4J_BOLT_PORT}

# --- backends (consumer: web edge, dev proxy, cli, ctl dev) ---
API_HOST=localhost               # docker: api (compose literal); +env_override reads this
API_PORT=8000
ENGINE_HOST=localhost            # docker: engine
ENGINE_PORT=8080
ENGINE_URL=http://${ENGINE_HOST}:${ENGINE_PORT}   # api → engine calls; docker: compose literal
API_PREFIX=/api
ENGINE_PREFIX=/engine

# --- frontends (consumer: web image, dev proxy, ctl dev) ---
# One origin. Each frontend owns one prefix; the web image and the dev proxy route by it.
WEB_LANDING_PREFIX=/             # apps/multi-web-app/landing  (Next.js static export)
WEB_APP_PREFIX=/app              # apps/multi-web-app/app      (Vite SPA)
WEB_DOCS_PREFIX=/docs            # apps/multi-web-app/docs     (Astro)
DASHBOARD_PREFIX=/dashboard      # apps/dashboard    (Next.js SSR server)
WEB_LANDING_PORT=3001            # dev servers on the host (ctl dev)
WEB_APP_PORT=5173
WEB_DOCS_PORT=4321
DASHBOARD_PORT=3000
DASHBOARD_HOST=localhost         # docker: dashboard; +env_override reads this
DEV_PROXY_PORT=3080              # docker/compose.dev.yaml — the one origin in dev

# --- shared secrets (consumer: api, engine) ---
JWT_SIGNING_KEY=
ENCRYPTION_KEY_PYTHON=
ENCRYPTION_KEY_RUST=

# --- public ---
PUBLIC_URL=http://localhost
PUBLIC_HOST=localhost            # traefik Host() rule

# --- compose plumbing ---
COMPOSE_PROJECT_NAME=<project>
DATA_DIR=./data
REGISTRY=ghcr.io/<org>
TAG=latest
HTTP_PORT=80
HTTPS_PORT=443
