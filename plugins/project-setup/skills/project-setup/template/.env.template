# Local configuration and secrets. Commit this template; keep the filled .env ignored.
# ctl setup copies this file and generates blank local secrets. Process environment wins.
# Only explicitly selected public constants may reach browser code.

#################### DEBUGGING ##########################
#################################################################
# Add project-specific debugging keys here; select browser flags explicitly in framework config.

#################### AUTHENTICATION ##########################
#################################################################

# Sign-in
# Read by every backend's loader; the browser never sees it. TRUE requires sign-in.
# FALSE: a local request with no credential acts as the reserved `default` user (V3 migration).
# Backends refuse FALSE on a non-loopback listener or public origin; compose always sets TRUE.
AUTH_ENABLED=FALSE

#################### SERVICE ADDRESSES ##########################
#################################################################

# API
# docker: api
API_HOST=localhost
API_PORT=8000
API_PREFIX=/api

# Engine
# docker: engine
ENGINE_HOST=localhost
ENGINE_PORT=8080
ENGINE_PREFIX=/engine
# api → engine calls; docker: compose literal
ENGINE_URL=http://${ENGINE_HOST}:${ENGINE_PORT}

# Dashboard
# docker: dashboard
DASHBOARD_HOST=localhost
DASHBOARD_PORT=3000
DASHBOARD_PREFIX=/dashboard

# Landing frontend
# Next.js export. Owns / — exactly one piece owns the root, and it has no _PREFIX key.
WEB_LANDING_PORT=3001

# Web app
# Vite SPA. Also the port of apps/example-single-web-app-vite
WEB_APP_PORT=5173
# single-frontend shape: /
WEB_APP_PREFIX=/app

# Docs frontend
# Astro
WEB_DOCS_PORT=4321
WEB_DOCS_PREFIX=/docs

# Beta API
# Optional external backend. Uncomment all three when the web edge routes /beta.
# BETA_API_HOST=
# BETA_API_PORT=
# BETA_API_PREFIX=/beta

# Postgres
# docker: compose sets `postgres`
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
# docker: `redis`
REDIS_HOST=localhost
REDIS_PORT=6379

# Neo4j
# docker: `neo4j`
NEO4J_HOST=localhost
NEO4J_BOLT_PORT=7687

# Public origin
# Optional public deployment: uncomment all three before ctl up +public.
# apps use this origin for absolute URLs
# PUBLIC_URL=https://<domain>
# edge publication: <HTTP_PORT>:8080
# HTTP_PORT=80
# edge publication: <HTTPS_PORT>:8443; mount TLS certs
# HTTPS_PORT=443

# Payments
# optional backend integration
# PAYMENTS_URL=https://api.stripe.com

#################### DATA PATHS ##########################
#################################################################

# Storage
# Local paths are relative to this repository, or absolute deployment paths.
# In production it can be /DATA/AppData/<Company-Name>/<Project-name>.
BASE_DIR=.

DATA_DIR=${BASE_DIR}/data

# Logs and backups
LOGS_DIR=${BASE_DIR}/logs
BACKUP_DIR=${LOGS_DIR}/backups

# Datasets
# enable only for a training app
# DATASET_DIR=${DATA_DIR}/datasets

#################### SECRETS ##########################
#################################################################

# Postgres
# Backend and database values; credential-bearing URLs remain server-only.
# ctl setup generates blank _PASSWORD, _KEY and _SECRET keys. Rotate passwords yearly or on leak.
POSTGRES_USER=app
# generated by ctl setup: openssl rand -base64 24 | tr -d '+/=' | head -c 24
POSTGRES_PASSWORD=
POSTGRES_DB=app
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis
# generated by ctl setup
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

# Neo4j
# generated by ctl setup
NEO4J_PASSWORD=
NEO4J_URL=bolt://${NEO4J_HOST}:${NEO4J_BOLT_PORT}

# Shared authentication
# generated by ctl setup: openssl rand -hex 32. Rotate on leak; invalidates every token.
JWT_SIGNING_KEY=

# API encryption
# generated by ctl setup: openssl rand -hex 32. Never rotate without a re-encrypt migration.
ENCRYPTION_KEY_PYTHON=

# Engine encryption
# generated by ctl setup: openssl rand -hex 32
ENCRYPTION_KEY_RUST=

# Google authentication
# Provider credentials: obtain from the provider, then uncomment and fill; never auto-generate.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# OpenAI
# backend proxy only; rotate on leak
# OPENAI_API_KEY=

#################### RUST ##########################
#################################################################
# ctl dev, ctl test and ctl gate hand these to every Cargo command they start, as the Cargo
# variable each comment names. A key here starts with CTL_RUST_, never CARGO_ or RUST, because ctl
# exports every key in this file to every process it starts, and Cargo reads those names itself.
# Compiler jobs are TEST_BUILD_JOBS, under TESTING.

# Debug info
# debug info in dev and test builds of this repo's own crates, as CARGO_PROFILE_DEV_DEBUG (the test
# profile inherits it): 0, line-tables-only (a backtrace names file and line), limited, or full (a
# debugger shows variables). Dependencies keep the setting Cargo.toml gives them; release builds are unchanged.
# empty: Cargo.toml decides; a CARGO_PROFILE_DEV_DEBUG set in the shell wins
CTL_RUST_DEBUG=

#################### TESTING ##########################
#################################################################
# ctl gate and ctl test read these. A ctl gate flag wins over the shell, the shell over this file,
# and this file over the default its comment names. An empty value keeps that default.

# Cores, compiler jobs and memory
# cores every gate and test run may use, as taskset -c reads them: 0-7 or 0-3,8-11
# empty: every core; ctl gate --cpus wins
TEST_CPUS=
# compiler jobs per Cargo command; a CARGO_BUILD_JOBS line in this file does not set it
# empty: one per core, at most one per 2 GB of the memory budget; ctl gate --build-jobs, then CARGO_BUILD_JOBS in the shell, win
TEST_BUILD_JOBS=
# memory budget of one run, such as 8G or 512M; the gate's memory lid has this size
# empty: 80 % of the memory available when the run starts; ctl gate --memory wins
TEST_MEMORY=

#################### DEPLOYMENT ##########################
#################################################################

# Compose
# Compose project identity and image selection.
COMPOSE_PROJECT_NAME=<project>

# Images
REGISTRY=ghcr.io/<org>
# immutable per deploy: a git sha or a semver. `dev` is for local builds only
TAG=dev

#################### WORKTREES ##########################
#################################################################
# ctl worktree reads these from the main tree's .env, whichever checkout runs it; the shell wins.

# Slots
# the most warm slots .worktrees/ may hold. Empty: 4
WORKTREE_SLOTS=
# ctl worktree trim deletes the Cargo outputs no build used for this many days. Empty: 7
WORKTREE_TRIM_DAYS=
# 1: ctl dev, test, gate and build refuse in the main tree, so work happens in .worktrees/. Empty or 0: off
WORKTREE_ONLY=
