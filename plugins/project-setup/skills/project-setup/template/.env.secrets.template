# .env.secrets — every secret of the project, in one place.
#
# Purpose   Passwords, signing keys, encryption keys, third-party credentials, and the database
#           connection values (host, port, URL) that pair with them. Nothing else.
#           Database endpoints belong here, not in .env.proxy: nothing routes them and no frontend
#           sees them. Point them at a hosted engine (RDS, ElastiCache) and nothing else changes.
# Readers   docker compose (interpolation into compose.base.yaml / compose.db.yaml) and the backend
#           config loaders (config.py / config.rs / config.go). A frontend never reads this file.
# Template  `ctl setup` copies this file to .env.secrets and fills every blank value whose key ends
#           in _PASSWORD, _KEY or _SECRET. Third-party credentials stay blank until you paste them.
# Rules     Committed: this template only, every secret blank. .env.secrets is gitignored.
#           A secret appears in a backend's config.yaml only as ${VAR}. `ctl check` fails on a literal.
#           Never read .env.secrets when auditing. Read this template.

# --- postgres (readers: api, engine, migrations) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=                     # generated by ctl setup: openssl rand -base64 24 | tr -d '+/=' | head -c 24
POSTGRES_DB=app
POSTGRES_HOST=localhost                # docker: compose sets `postgres`
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- redis (readers: api) ---
REDIS_PASSWORD=                        # generated by ctl setup
REDIS_HOST=localhost                   # docker: `redis`
REDIS_PORT=6379
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

# --- neo4j (readers: engine) ---
NEO4J_PASSWORD=                        # generated by ctl setup
NEO4J_HOST=localhost                   # docker: `neo4j`
NEO4J_BOLT_PORT=7687
NEO4J_URL=bolt://${NEO4J_HOST}:${NEO4J_BOLT_PORT}

# --- shared keys (readers: api, engine) ---
# One key when two services validate the same token. Separate keys when they do not share.
JWT_SIGNING_KEY=                       # generated by ctl setup: openssl rand -hex 32. Rotate on leak; invalidates every token.
ENCRYPTION_KEY_PYTHON=                 # generated by ctl setup: openssl rand -hex 32. Never rotate without a re-encrypt migration.
ENCRYPTION_KEY_RUST=                   # generated by ctl setup: openssl rand -hex 32

# --- third-party credentials (readers: api) ---
# From the provider's console. Rotate on leak. Keep the block commented until the integration exists.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OPENAI_API_KEY=                      # AI keys live here and only here; the frontend calls a backend proxy route

# --- registry (readers: compose) ---
REGISTRY=ghcr.io/<org>
TAG=dev                              # immutable per deploy: a git sha or a semver. `dev` is for local builds only
