# .mise.toml — runtime version contract
#
# `mise install` from a clean clone should produce a working toolchain.
#
# Runtimes carry a <version> placeholder. Resolve each to a current stable release
# (`mise ls-remote python | tail`) before running `mise install`.

[tools]
python = "<version>"
node   = "<version>"
bun    = "latest"
# rust   = "<version>"            # if using rust; or pin via rust-toolchain.toml inside the rust folder
# go     = "<version>"

[env]
# Optional — project-scoped env vars applied when entering the directory.
# Prefer .env for runtime config; this is for shell ergonomics.
PYTHONDONTWRITEBYTECODE = "1"
